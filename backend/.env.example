# Required by the backend
#DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#SECRET_KEY=generate-a-unique-random-secret-at-least-32-bytes-long
# Optional overlap key for a rolling JWT key rotation. Remove after the old
# token lifetime has elapsed (the longest current session is 180 minutes).
#SECRET_KEY_PREVIOUS=
# Keep the per-function connection pool small for Vercel/serverless. Increase
# only after checking your PostgreSQL provider's pooled connection capacity.
#DB_POOL_SIZE=1
#DB_MAX_OVERFLOW=0
#DB_POOL_TIMEOUT=10
#DB_POOL_RECYCLE=300

# Required to store exam images/audio outside PostgreSQL.
# Create a private bucket named exam-media in Supabase Storage.
#SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
#SUPABASE_MEDIA_BUCKET=exam-media

# Required for admin email / OTP flows
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USERNAME=your-smtp-account
#SMTP_PASSWORD=your-smtp-app-password
#SMTP_FROM_EMAIL=your-sender@example.com
#SMTP_FROM_NAME=EPS TOPIK EXAM

# Student email registration verification
#OTP_EXPIRE_MINUTES=5
#OTP_RESEND_COOLDOWN_SECONDS=30
#OTP_MAX_ATTEMPTS=5
# Required to reject mailboxes that ZeroBounce reports as invalid before sending registration OTPs.
#ZEROBOUNCE_API_KEY=your-zerobounce-api-key

# Optional recipients used only for the two-person admin onboarding approval flow.
#ADMIN_EMAIL=authorized-admin@example.com
#DEVELOPER_EMAIL=authorized-developer@example.com

# Optional JWT lifetime overrides (minutes).
# Admin access token duration. Student sessions have their own 180-minute setting.
#ACCESS_TOKEN_EXPIRE_MINUTES=60
#STUDENT_ACCESS_TOKEN_EXPIRE_MINUTES=180
#ALGORITHM=HS256

# Comma-separated exact origins. Replace the placeholder after the frontend deploys.
#CORS_ORIGINS=http://localhost:5500,https://YOUR-FRONTEND-PROJECT.vercel.app

